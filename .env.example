DB_HOST=db
DB_NAME=iq_creative
DB_USER=iq_user
DB_PASSWORD=change_this_password
MYSQL_ROOT_PASSWORD=change_this_root_password
APP_BASE_PATH=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=IQ-CREATIVE

# Required to enable profile/topup/webhook.php (Telegram payment-approval bot).
# Must match the `secret_token` you pass to Telegram's setWebhook API:
# https://core.telegram.org/bots/api#setwebhook
# Leave empty to keep the webhook disabled (it fails closed with 401 when unset).
TELEGRAM_WEBHOOK_SECRET=
